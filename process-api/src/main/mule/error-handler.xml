<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" 
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" 
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" 
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd 
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ====================================================== -->
    <!-- CENTRALIZED ERROR HANDLER CONFIGURATION                 -->
    <!-- Catches errors across flows and returns clean responses-->
    <!-- ====================================================== -->
    <error-handler name="papi-global-error-handler" doc:id="a50da564-2010-4480-aefe-02f13f5cf7c8">
        
        <!-- 1. Handle Supplier Business Rejections (MOQ / Validation) -->
        <on-error-propagate type="APP:INVALID_SUPPLIER_ORDER" enableNotifications="true" logException="true">
            <ee:transform doc:name="Transform Supplier Error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: "SUPPLIER_VALIDATION_FAILED",
    message: error.description default "The supplier rejected the purchase order.",
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">422</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 2. Handle HTTP Connectivity Failures (e.g., System API is down) -->
        <on-error-propagate type="HTTP:CONNECTIVITY, HTTP:TIMEOUT" enableNotifications="true" logException="true">
            <ee:transform doc:name="Transform Connectivity Error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: "PAPI_CONNECTION_ERROR",
    message: "Failed to communicate with downstream System API layer.",
    details: error.description,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">503</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 3. Handle 404 Not Found Errors -->
        <on-error-propagate type="PAPI:NOT_FOUND" enableNotifications="true" logException="true">
            <ee:transform doc:name="Transform Not Found Error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: "PAPI_NOT_FOUND",
    message: error.description default "The requested resource could not be found.",
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 4. Catch-All for Any Other Unexpected Errors -->
        <on-error-propagate type="ANY" enableNotifications="true" logException="true">
            <ee:transform doc:name="Transform Generic Server Error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: "PAPI_INTERNAL_SERVER_ERROR",
    message: "An unexpected error occurred in the Process API layer.",
    details: error.description,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss'Z'"}
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

    </error-handler>

</mule>