<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="experience-api-test-suite.xml" />
	
	<munit:test name="experience-api-test-suite-post:\reorders\manual\(sku):inventory-configTest" doc:id="5935db09-8dc2-478c-84e7-29e0bb1ebf1e" description="Test manual reorder flow">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert">
				<munit-tools:then-return />
			</munit-tools:mock-when>
		</munit:behavior>
		
		<munit:execution>
			<munit:set-event>
				<munit:attributes value="#[{ uriParams: { sku: 'SKU-HOME-5013' } }]"/>
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\reorders\manual\(sku):inventory-config" doc:id="08db12c0-4b0c-48ed-a6ee-41bc369eb644" name="post:\reorders\manual\(sku):inventory-config"/>
		</munit:execution>
		
		<munit:validation>
			<munit-tools:assert-equals actual="#[payload.status]" expected="SUBMITTED" message="Status mismatch"/>
			<munit-tools:assert-equals actual="#[payload.sku]" expected="SKU-HOME-5013" message="SKU mismatch"/>
		</munit:validation>
	</munit:test>

</mule>